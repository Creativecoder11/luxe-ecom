# ---- Runtime environment -------------------------------------------------
# development | test | staging | production  (separate from NODE_ENV)
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql://USER@localhost:5432/ucp_dev
# Used only by integration tests (pnpm test:integration). Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER@localhost:5432/ucp_test
# Used only by E2E tests (pnpm test:e2e). Reset and seeded on every run; name must end in _e2e.
E2E_DATABASE_URL=postgresql://USER@localhost:5432/ucp_e2e

# ---- Storefront identity (until Business settings UI exists) -------------
NEXT_PUBLIC_STORE_NAME=Luxe

# ---- Shell preview -------------------------------------------------------
# Renders the unauthenticated /admin and /account shells in a production build
# (used by E2E tests). Rejected at boot when APP_ENV=production.
SHELL_PREVIEW=false

# ---- Authentication ------------------------------------------------------
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# ---- Integrations (unconfigured until a real provider is contracted) -----
EMAIL_PROVIDER=none

# ---- File storage --------------------------------------------------------
# local (development only) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads

# ---- Development seed only -----------------------------------------------
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=dev-owner-password-change-me
